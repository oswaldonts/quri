# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

node_modules
*.local

# Build output is embedded in the Go binary (web/embed.go). Only the .gitkeep is tracked,
# so the embed compiles on a fresh checkout before the frontend has been built.
dist/*
!dist/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
